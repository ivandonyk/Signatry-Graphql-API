{
    "compilerOptions": {
        "module": "commonjs",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "es6",
        "noImplicitAny": false,
        "moduleResolution": "node",
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": ".",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "allowJs": true,
        "paths": {
            "*": [
                "./node_modules/*"
            ]
        },
        "lib": [
            "es5",
            "es6",
            "esnext.asynciterable",
            "es2017",
            "es2018",
            "es2019",
            "es2020",
            "dom"
        ]
    }
}