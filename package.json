{
    "name": "signatry-graphql-api",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "clean:dist": "rm -rfv ./dist/*",
        "build": "tsc -p .",
        "build:watch": "tsc -w -p .",
        "watch-typescript": "rm -rfv ./dist/* && tsc -w -p .",
        "watch-dist": "nodemon --legacy-watch --delay 2 --watch ./dist --inspect=0.0.0.0:9229 --nolazy ./dist/src/index.js",
        "debug": "concurrently npm:watch-*",
        "docker-debug": "docker-compose up",
        "start": "node ./dist/src/index.js",
        "test:ci": "jest --ci --runInBand --no-watchman --reporters='default' --max_old_space_size=512 --passWithNoTests",
        "tsc": "tsc",
        "stripe:listen": "ultrahook -k oKHgMk64b4Z4QzC95ewsfWvUnBNPUqg5 stripe http://localhost:8080/api/stripe",
        "typeorm": "npx typeorm",
        "migration:run": "npx typeorm migration:run --config dist/ormconfig.js",
        "migration:generate": "npm run build && npx typeorm migration:generate --config dist/ormconfig.js -n",
        "migration:create": "npx typeorm migration:create --config dist/ormconfig.js -n",
        "migration:revert": "npx typeorm migration:revert --config dist/ormconfig.js",
        "create-admin-user": "ts-node ./src/scripts/createAdminUser.ts",
        "seed-recipient-associations": "./node_modules/.bin/dotenv -e ../.env ./node_modules/.bin/ts-node ./src/scripts/charities/seedDummyCharityProfiles.ts",
        "lint": "eslint --ext .ts,.tsx ./src"
    },
